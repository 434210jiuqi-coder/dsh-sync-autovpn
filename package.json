{
  "name": "dsh-sync-autovpn",
  "version": "0.1.0",
  "description": "DSH 插件：GitHub 同步（@dpskk2/dsh-chatsync）或命令行 git push/pull 一开始就自动开启本机 Clash 代理，同步结束、空闲后自动关闭并逐项还原；代理实例借用 dsh-clash-autovpn（单一实例原则）。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "clash",
    "vpn",
    "proxy",
    "github",
    "sync",
    "chatsync",
    "git-push"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./trigger": "./lib/trigger.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/trigger.test.mjs",
    "test:preflight": "node test/plugin-load.mjs && node test/wiring.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "author": "434210jiuqi-coder",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/434210jiuqi-coder/dsh-sync-autovpn.git"
  },
  "homepage": "https://github.com/434210jiuqi-coder/dsh-sync-autovpn#readme",
  "bugs": {
    "url": "https://github.com/434210jiuqi-coder/dsh-sync-autovpn/issues"
  }
}
